# Exheader / RSF du sysmodule tricord_presenced.
#
# Modèle : sysmodule homebrew "Plug-n-play" (zaksabeast/3ds-Plug-n-play, pnp_sys/pnp.rsf,
# chargé par Luma3DS >= 12 depuis /luma/sysmodules/<TitleID>.cxi) et rosalina.rsf
# (LumaTeam/Luma3DS). Voir RAPPORT.md §Sysmodule pour le détail des choix.
#
# Title ID résultant : 0004013000 | (UniqueId << 8) | 0x02  =>  000401300F000102
# Le fichier DOIT s'appeler 000401300F000102.cxi sur la SD (Luma3DS
# sysmodules/loader/source/patcher.c : openSysmoduleCxi()).

BasicInfo:
  Title                   : tricord_presenced
  CompanyCode             : "00"
  ProductCode             : TRICORDPRS
  ContentType             : Application
  Logo                    : None

TitleInfo:
  UniqueId                : $(UNIQUE_ID)
  Category                : Base
  Version                 : 2

Option:
  UseOnSD                 : false
  FreeProductCode         : true
  MediaFootPadding        : false
  EnableCrypt             : false
  EnableCompress          : false

AccessControlInfo:
  # Core système (core 1) pour ne pas voler de CPU au jeu au premier plan.
  IdealProcessor                : 1
  AffinityMask                  : 2
  Priority                      : 28

  DisableDebug                  : true
  EnableForceDebug              : false
  CanWriteSharedPage            : false
  CanUsePrivilegedPriority      : false
  CanUseNonAlphabetAndNumber    : false
  PermitMainFunctionArgument    : false
  CanShareDeviceMemory          : false
  RunnableOnSleep               : true
  SpecialMemoryArrange          : false
  ResourceLimitCategory         : sysapplet

  CoreVersion                   : 2
  DescVersion                   : 2

  # TODO(hardware): "System" + sysapplet = même combinaison que Plug-n-play
  # (prouvée au boot Luma 12+). Rosalina utilise Base + Other. À revalider si
  # l'allocation heap (__ctru_heap_size dans main.c) échoue sur o3DS.
  MemoryType                    : System
  HandleTableSize               : 0x80
  MemoryMapping:
  IORegisterMapping:

  SystemCallAccess:
    ControlMemory: 0x01
    QueryMemory: 0x02
    ExitProcess: 0x03
    GetProcessIdealProcessor: 0x06
    CreateThread: 0x08
    ExitThread: 0x09
    SleepThread: 0x0A
    GetThreadPriority: 0x0B
    SetThreadPriority: 0x0C
    GetThreadIdealProcessor: 0x0F
    GetCurrentProcessorNumber: 0x11
    CreateMutex: 0x13
    ReleaseMutex: 0x14
    CreateSemaphore: 0x15
    ReleaseSemaphore: 0x16
    CreateEvent: 0x17
    SignalEvent: 0x18
    ClearEvent: 0x19
    CreateTimer: 0x1A
    SetTimer: 0x1B
    CancelTimer: 0x1C
    ClearTimer: 0x1D
    CreateMemoryBlock: 0x1E
    MapMemoryBlock: 0x1F
    UnmapMemoryBlock: 0x20
    CreateAddressArbiter: 0x21
    ArbitrateAddress: 0x22
    CloseHandle: 0x23
    WaitSynchronization1: 0x24
    WaitSynchronizationN: 0x25
    DuplicateHandle: 0x27
    GetSystemTick: 0x28
    GetHandleInfo: 0x29
    GetSystemInfo: 0x2A
    GetProcessInfo: 0x2B
    GetThreadInfo: 0x2C
    ConnectToPort: 0x2D
    SendSyncRequest1: 0x2E
    SendSyncRequest2: 0x2F
    SendSyncRequest3: 0x30
    SendSyncRequest4: 0x31
    SendSyncRequest: 0x32
    GetProcessId: 0x35
    GetProcessIdOfThread: 0x36
    GetThreadId: 0x37
    GetResourceLimit: 0x38
    GetResourceLimitLimitValues: 0x39
    GetResourceLimitCurrentValues: 0x3A
    GetThreadContext: 0x3B
    Break: 0x3C
    OutputDebugString: 0x3D
    CreatePort: 0x47
    CreateSessionToPort: 0x48
    AcceptSession: 0x4A
    ReplyAndReceive1: 0x4B
    ReplyAndReceive2: 0x4C
    ReplyAndReceive3: 0x4D
    ReplyAndReceive4: 0x4E
    ReplyAndReceive: 0x4F
  InterruptNumbers:

  # Services réellement utilisés (voir source/) :
  #  - APT:S / APT:A / APT:U : GetAppletManInfo / GetAppletInfo (apt_monitor.c),
  #    ordre d'essai identique à libctru apt.c (serviceNameTable).
  #  - fs:USER : lecture de config.txt / titles.txt / accounts TriCord et
  #    log sur la SD.
  #  - soc:U   : sockets pour la Gateway Discord (discord_gateway.c).
  #  - ndm:u   : NDMU_EnterExclusiveState pour garder le WiFi en mode
  #    infrastructure en arrière-plan (comme Rosalina minisoc.c).
  #  - ac:u    : ACU_GetStatus pour attendre la connexion Internet.
  #  - ps:ps   : PS_EncryptDecryptAes(PS_KEYSLOT_0D) pour déchiffrer
  #    sdmc:/3ds/TriCord/accounts (tricord_account_bridge.c) — même appel
  #    que TriCord lui-même dans Config::load()/save(). C'est le service qui
  #    permet de récupérer le compte déjà connecté SANS demander de token.
  ServiceAccessControl:
    - APT:S
    - APT:A
    - APT:U
    - fs:USER
    - soc:U
    - ndm:u
    - ac:u
    - ps:ps
    - ptm:gets  # PTMGETS_GetSystemTime pour timer Discord (heure système 3DS,
    - ptm:sysm  #   avec fallback RTC via ptm:sysm si l'utilisateur a un
                #   ptm:gets restreint).
  FileSystemAccess:
    - DirectSdmc
    - CategorySystemApplication

SystemControlInfo:
  SaveDataSize: 0KB
  RemasterVersion: 0
  StackSize: 0x4000
  Dependency:
    ac: 0x0004013000002402
    cfg: 0x0004013000001702
    ndm: 0x0004013000002b02
    socket: 0x0004013000002e02
    # Title ID du module PS (NATIVE_FIRM) = 0004013000003102.
    # Source : 3dbrew.org "Title list" / "PS_Services" — le module PS porte
    # le Title ID 0004013000003102 sur toutes les régions (identique à la
    # ligne "ps: 0x0004013000003102" déjà présente dans
    # installer/tricord-presence-installer.rsf, elle-même dérivée d'un RSF
    # d'application officielle). Confirmé cohérent avec les autres entrées
    # NATIVE_FIRM ci-dessus (cfg=..1702, ndm=..2b02, socket=..2e02).
    # Sans cette dépendance, srv peut bloquer sur GetServiceHandle("ps:ps")
    # si le module PS n'est pas déjà démarré au moment où ce sysmodule tourne.
    ps: 0x0004013000003102
